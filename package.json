{
  "name": "scarletx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node-pg-migrate up -m src/db/migrations",
    "db:rollback": "node-pg-migrate down -m src/db/migrations"
    ,"backfill": "tsx scripts/backfill-provider.ts"
    ,"backfill:local": "bash scripts/backfill-local.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  }
}
